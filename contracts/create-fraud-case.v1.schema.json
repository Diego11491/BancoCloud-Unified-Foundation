{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bancocloud.local/contracts/create-fraud-case.v1.schema.json",
  "title": "CreateFraudCase.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "command_id", "transaction_id", "risk_score", "risk_level",
    "reason_codes", "model_version", "policy_version", "correlation_id", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "command_id": {"type": "string", "format": "uuid"},
    "transaction_id": {"type": "string", "format": "uuid"},
    "risk_score": {"type": "number", "minimum": 0, "maximum": 1},
    "risk_level": {"const": "HIGH"},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "model_version": {"type": "string"},
    "policy_version": {"type": "string"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
