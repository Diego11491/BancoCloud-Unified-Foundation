# Copy to .env; replace every demo placeholder before starting Docker.
POSTGRES_PASSWORD=replace-with-long-random-local-password
DEMO_API_KEY=replace-with-long-random-local-key
DATABASE_URL=postgresql://bancocloud:replace-with-long-random-local-password@db:5432/bancocloud
FRAUD_URL=http://fraud:8000/ingest
POLICY_PATH=/app/config/policy.v1.json
EVENT_SINK=local-http

# Phase 2 Azure Event Hubs. Keep EVENT_SINK=local-http until the real Azure
# preflight, RBAC and budget gates pass. Never commit AZURE_CLIENT_SECRET.
AZURE_EVENTHUB_FULLY_QUALIFIED_NAMESPACE=
AZURE_EVENTHUB_NAME=transaction-posted-v1
AZURE_EVENTHUB_CONSUMER_GROUP=fraud-engine
AZURE_BLOB_ACCOUNT_URL=
AZURE_BLOB_CHECKPOINT_CONTAINER=eventhub-checkpoints
AZURE_MANAGED_IDENTITY_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Core remains bound to loopback by default. Use 0.0.0.0 only for a controlled
# physical-device demo on the same private network, then restore 127.0.0.1.
CORE_BIND_ADDRESS=127.0.0.1
CORE_HOST_PORT=8080

# Browser origins only; Expo/React Native native requests do not enforce CORS.
# Never use * and do not add URL paths.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# GenAI is optional and outside the critical path. Leave GENAI_ENDPOINT empty for
# the deterministic local mode. Never commit a real key.
GENAI_ENDPOINT=
GENAI_API_KEY=
GENAI_MODEL=
GENAI_PROVIDER=azure-openai
GENAI_AUTH_HEADER=api-key
GENAI_AUTH_SCHEME=
GENAI_TIMEOUT_SECONDS=15
